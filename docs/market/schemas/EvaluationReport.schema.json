{
  "$defs": {
    "EvaluationReport": {
      "additionalProperties": false,
      "properties": {
        "abstained_count": {
          "type": "integer"
        },
        "availability_basis": {
          "enum": [
            "synthetic_ground_truth",
            "evidenced_historical",
            "collector_observation_proxy",
            "unknown"
          ],
          "type": "string"
        },
        "availability_confidence": {
          "type": "string"
        },
        "available_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "censored_count": {
          "type": "integer"
        },
        "dataset_kind": {
          "type": "string"
        },
        "evaluated_count": {
          "type": "integer"
        },
        "event_at": {
          "type": "string"
        },
        "forecast_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ingested_at": {
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "type": "array"
        },
        "observed_at": {
          "type": "string"
        },
        "original_timezone": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "record_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "run_sha256": {
          "type": "string"
        },
        "schema_name": {
          "const": "EvaluationReport"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "source_id": {
          "type": "string"
        },
        "source_record_id": {
          "type": "string"
        },
        "stale_count": {
          "type": "integer"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_precision": {
          "type": "string"
        },
        "total_count": {
          "type": "integer"
        }
      },
      "required": [
        "schema_name",
        "schema_version",
        "record_id",
        "source_id",
        "source_record_id",
        "revision",
        "supersedes_record_id",
        "event_at",
        "available_at",
        "observed_at",
        "ingested_at",
        "availability_basis",
        "availability_confidence",
        "original_timezone",
        "timestamp_precision",
        "provenance",
        "run_id",
        "run_sha256",
        "dataset_kind",
        "forecast_ids",
        "metrics",
        "total_count",
        "evaluated_count",
        "censored_count",
        "abstained_count",
        "stale_count",
        "caveats"
      ],
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "raw_sha256": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "untrusted_source_text": {
          "type": "boolean"
        }
      },
      "required": [
        "raw_sha256",
        "adapter_version",
        "rights",
        "license",
        "synthetic",
        "untrusted_source_text"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/EvaluationReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
