        },
        "availability_confidence": {
          "type": "string"
        },
        "available_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_snapshot_id": {
          "type": "string"
        },
        "event_at": {
          "type": "string"
        },
        "future_record_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ingested_at": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "original_timezone": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "record_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "schema_name": {
          "const": "FutureTarget"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "source_id": {
          "type": "string"
        },
        "source_record_id": {
          "type": "string"
        },
        "split": {
          "type": "string"
        },
        "stop_gradient": {
          "type": "boolean"
        },
        "supersedes_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_precision": {
          "type": "string"
        },
        "window_end_at": {
          "type": "string"
        },
        "window_start_at": {
          "type": "string"
        }
      },
      "required": [
        "schema_name",
        "schema_version",
        "record_id",
        "source_id",
        "source_record_id",
        "revision",
        "supersedes_record_id",
        "event_at",
        "available_at",
        "observed_at",
        "ingested_at",
        "availability_basis",
        "availability_confidence",
        "original_timezone",
        "timestamp_precision",
        "provenance",
