          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "raw_sha256": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "untrusted_source_text": {
          "type": "boolean"
        }
      },
      "required": [
        "raw_sha256",
        "adapter_version",
        "rights",
        "license",
        "synthetic",
        "untrusted_source_text"
      ],
      "type": "object"
    }
